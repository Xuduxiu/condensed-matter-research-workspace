# CondMat Radar machine-local configuration template.
# The Windows installer writes resolved absolute paths into:
# %LOCALAPPDATA%\CondMatRadar\config\.env.local
CONDMAT_RADAR_DATA_DIR=
CONDMAT_RADAR_DB=
CONDMAT_RADAR_CACHE=
CONDMAT_RADAR_EXPORT=
CONDMAT_RADAR_LOGS=
CONDMAT_RADAR_LOCKS=
CONDMAT_RADAR_API_HOST=127.0.0.1
CONDMAT_RADAR_API_PORT=8765

# Academic metadata services. Crossref and arXiv do not require API keys.
OPENALEX_API_KEY=
OPENALEX_MAILTO=
UNPAYWALL_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=

# Optional campus/institutional IP access. This never imports browser cookies
# or automates SSO. Supported value: ip_only (default: disabled).
CONDMAT_RADAR_INSTITUTIONAL_ACCESS=disabled

# DeepSeek is optional. Keep real values only in .env.local, never in this file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# Optional legacy paper-intake bridge. The new Windows package does not require it.
PAPER_DOWNLOADER_ROOT=
PAPER_DOWNLOADER_INBOX=