{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/api.ts",
    "src/hooks.ts",
    "src/types.ts",
    "src/vite-env.d.ts",
    "src/components/AppShell.tsx",
    "src/components/Sidebar.tsx",
    "src/components/TopBar.tsx",
    "src/components/primitives.tsx",
    "src/components/PaperRow.tsx",
    "src/components/PaperTable.tsx",
    "src/components/PaperDetailPanel.tsx",
    "src/components/MaterialRow.tsx",
    "src/components/MaterialDetailPanel.tsx",
    "src/pages/Dashboard.tsx",
    "src/pages/Discover.tsx",
    "src/pages/Library.tsx",
    "src/pages/Materials.tsx",
    "src/pages/Monitors.tsx",
    "src/pages/System.tsx"
  ]
}
