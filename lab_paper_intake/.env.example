# PAPER_INTAKE_PDF_DIR=G:\paper-intake\pdfs
# PAPER_INTAKE_EXPORT_DIR=G:\paper-intake\exports
PAPER_INTAKE_REQUEST_TIMEOUT_SECONDS=30