# Optional LLM configuration
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# Required for DOI-based Unpaywall lookups
UNPAYWALL_EMAIL=your_email@example.com

# Optional paths, resolved from the workspace root when relative
