# Source checkout defaults. Paths are relative to this workspace root.
CONDMAT_RADAR_DATA_DIR=condmat-trend-radar/data
CONDMAT_RADAR_DB=condmat-trend-radar/data/processed/condmat_trends.sqlite
CONDMAT_RADAR_API_HOST=127.0.0.1
CONDMAT_RADAR_API_PORT=8000
CONDMAT_RADAR_INSTITUTIONAL_ACCESS=disabled

# Shared optional LLM configuration
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# Academic metadata services
OPENALEX_API_KEY=
OPENALEX_MAILTO=your_email@example.com
UNPAYWALL_EMAIL=your_email@example.com
SEMANTIC_SCHOLAR_API_KEY=

# Unified bridge paths. Relative paths are resolved from this workspace root.
PAPER_DOWNLOADER_ROOT=lab_paper_intake
PAPER_DOWNLOADER_INBOX=lab_paper_intake\data\inbox\trend_radar_download_tasks
PAPER_INTAKE_DATA_DIR=lab_paper_intake\data
PAPER_INTAKE_INBOX=lab_paper_intake\data\inbox\trend_radar_download_tasks
PAPER_INTAKE_REQUEST_TIMEOUT_SECONDS=30

# Optional external storage overrides for large real-data libraries.
# CONDMAT_RADAR_DATA_DIR=G:\condmat-trend-radar
# CONDMAT_RADAR_DB=G:\condmat-trend-radar\condmat_radar.sqlite
# CONDMAT_RADAR_CACHE=G:\condmat-trend-radar\cache
# CONDMAT_RADAR_EXPORT=G:\condmat-trend-radar\exports
# CONDMAT_RADAR_LOGS=G:\condmat-trend-radar\logs
# PAPER_INTAKE_PDF_DIR=G:\paper-intake\pdfs
# PAPER_INTAKE_EXPORT_DIR=G:\paper-intake\exports
# PAPER_INTAKE_DB=G:\paper-intake\papers.db
